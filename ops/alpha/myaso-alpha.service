[Unit]
Description=myaso.io R0 Authoritative Multiplayer Alpha (WebTransport/QUIC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myaso-alpha
Group=myaso-alpha
WorkingDirectory=/srv/myaso/alpha/current
Environment=MYASO_BIND=0.0.0.0:4433
Environment=MYASO_MAX_PLAYERS=8
Environment=MYASO_CERT_PEM=/etc/myaso-alpha/tls/cert.pem
Environment=MYASO_KEY_PEM=/etc/myaso-alpha/tls/key.pem
ExecStart=/srv/myaso/alpha/current/bin/myaso-server
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=320M
MemoryMax=512M
CPUQuota=150%
UMask=0077

[Install]
WantedBy=multi-user.target
