# Core8A P723 selected FAMILY shared golden vectors — REVIEW ONLY.
# Exactly 16 bytes / 32 lowercase hex characters per value; little-endian u32.
# LMB byte3=00 is compatible with dormant codec. KeyE byte3=01 is PROPOSED ONLY.
# Rows are individual ABI examples, not a single legal combined state history.
# For future negotiated connection only. Original runtime currently denies KeyE.
# ACK byte3=00; ACK grants transport receipt, NEVER Combat HIT.
# Main approved 0x11/0x12 FAMILY, NOT byte3 source grammar or any live enable.
LMB_PRESS=0211010001000000010000002a000000
LMB_RELEASE=0211030002000000010000002a000000
KEY_E_PRESS=0211010103000000020000002b000000
KEY_E_RELEASE=0211030104000000020000002c000000
KEY_E_CANCEL=0211040105000000020000002d000000
LMB_UPGRADE=0211020006000000030000002a000000
LMB_CANCEL=0211040007000000030000002a000000
ACK_ACCEPTED=02120100030000000200000032000000
ACK_DUPLICATE=02120200030000000200000032000000
ACK_STALE=02120300030000000200000032000000
ACK_REJECTED=02120400030000000200000032000000
BAD_KEY_E_UPGRADE=0211020103000000020000002b000000
